GCP_PROJECT_ID=seu-project-id-google-cloud

# Limite de bytes por consulta no BigQuery (proteção de custo).
# A consulta de alunos processa ~256 MB; a de bolsa_familia_municipio
# processa ~24 GB (tabela fonte tem particionamento ruim fora do range
# 2022/2024); o free tier dá 1 TB/mês.
BQ_MAX_BYTES_BILLED=26000000000

# AWS — nuvem do projeto (credenciais via aws configure, nunca neste arquivo)
AWS_REGION=sa-east-1
S3_BUCKET=nome-do-seu-bucket-data-lake
KINESIS_STREAM_NAME=fiap-alfabetizacao-stream

# Gate de qualidade (src/qualidade/regras.py):
# bloquear (padrão) interrompe a execução quando uma regra bloqueante é
# violada, antes de publicar a Silver; alertar apenas registra e segue.
QUALIDADE_MODO=bloquear
